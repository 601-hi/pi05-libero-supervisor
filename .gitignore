# Generated media / arrays are excluded by default.
*.npz
*.npy
*.mp4
*.avi
*.mov
*.png
*.jpg
*.jpeg

# The small causal release artifacts are intentionally versioned.
!release/pi05-supervisor-v0.1-20261004/artifacts/snapshots/*.npz
!release/pi05-supervisor-v0.1-20261004/artifacts/results/*.mp4

# Keep technical Markdown reports under outputs, but exclude bulky derivatives.
outputs/**/*.json
outputs/**/*.csv
outputs/**/*.tsv
outputs/**/*.html
outputs/**/*.pdf
outputs/**/*.pkl
outputs/**/*.gz

